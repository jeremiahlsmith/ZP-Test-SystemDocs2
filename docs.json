{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zotec Partners",
  "colors": {
    "primary": "#8DC532",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Products",
        "products": [
          {
            "product": "Insurance Billing",
            "pages": [
              "untitled-page",
              "insurance-billing/eligibility-verification",
              "insurance-billing/claim-submission",
              "insurance-billing/denial-management",
              "insurance-billing/guarantor-billing",
              "insurance-billing/reporting",
              "insurance-billing/ai-account-classification"
            ]
          }
        ]
      },
      {
        "tab": "System",
        "groups": [
          {
            "group": "System",
            "pages": [
              "system/architecture",
              "system/changelog"
            ]
          },
          {
            "group": "API reference",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/image.png",
    "dark": "/images/image.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
